//EX3JOB   JOB  (ACCT001),'COBOL SQL EXAMPLE',
//             CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//             NOTIFY=&SYSUID
//*
//*------------------------------------------------------------*
//* EX3.JCL - JOB TO PRECOMPILE, COMPILE, BIND, AND RUN       *
//*           A COBOL PROGRAM WITH EMBEDDED DB2 SQL            *
//*------------------------------------------------------------*
//*
//*************** STEP 1 - DB2 PRECOMPILE ********************
//*
//STEP1    EXEC PGM=DSNHPC,
//             PARM='HOST(COBOL),APOST'
//STEPLIB  DD  DSN=DB2.V12.SDSNLOAD,DISP=SHR
//DBRMLIB  DD  DSN=MY.DBRMLIB(EX3),DISP=SHR
//SYSCIN   DD  DSN=&&DSNHOUT,DISP=(MOD,PASS),
//             UNIT=SYSDA,SPACE=(800,(500,500))
//SYSIN    DD  DSN=MY.SOURCE(EX3),DISP=SHR
//SYSPRINT DD  SYSOUT=*
//SYSTERM  DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*
//*************** STEP 2 - COBOL COMPILE AND LINK ************
//*
//STEP2    EXEC PROC=IGYWCL,
//             PARM.COBOL='APOST,RENT,OBJECT,LIB',
//             PARM.LKED='LIST,MAP,RENT'
//COBOL.SYSIN   DD  DSN=&&DSNHOUT,DISP=(OLD,DELETE)
//COBOL.SYSLIB  DD  DSN=DB2.V12.SDSNMACS,DISP=SHR
//              DD  DSN=SYS1.MACLIB,DISP=SHR
//LKED.SYSLMOD  DD  DSN=MY.LOADLIB(EX3),DISP=SHR
//LKED.SYSLIB   DD  DSN=DB2.V12.SDSNLOAD,DISP=SHR
//              DD  DSN=CEE.SCEELKED,DISP=SHR
//COBOL.SYSPRINT DD SYSOUT=*
//LKED.SYSPRINT  DD SYSOUT=*
//*
//*************** STEP 3 - DB2 BIND AND EXECUTE **************
//*
//STEP3    EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD  DSN=DB2.V12.SDSNLOAD,DISP=SHR
//         DD  DSN=MY.LOADLIB,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  BIND PACKAGE(EX3PKG) -
       MEMBER(EX3) -
       LIBRARY('MY.DBRMLIB') -
       ACTION(REPLACE) -
       ISOLATION(CS) -
       VALIDATE(BIND)
  RUN  PROGRAM(EX3) -
       PLAN(EX3PLAN) -
       LIBRARY('MY.LOADLIB')
  END
/*
//
